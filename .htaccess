# BEGIN WordPress
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>
# END WordPress

# -----------------------------------------------
# Sécurité
# -----------------------------------------------

# Bloquer l'accès direct à wp-config.php
<Files wp-config.php>
    Order allow,deny
    Deny from all
</Files>

# Bloquer xmlrpc.php (vecteur de brute-force et DDoS)
<Files xmlrpc.php>
    Order allow,deny
    Deny from all
</Files>

# Bloquer l'accès aux fichiers sensibles
<FilesMatch "^(\.env|\.git|\.htpasswd|readme\.html|license\.txt|wp-cli\.yml)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Désactiver le listing des répertoires
Options -Indexes

# Bloquer l'injection de scripts via query string
<IfModule mod_rewrite.c>
    RewriteCond %{QUERY_STRING} (\<|%3C).*script.*(\>|%3E) [NC,OR]
    RewriteCond %{QUERY_STRING} GLOBALS(=|\[|\%[0-9A-Z]{0,2}) [OR]
    RewriteCond %{QUERY_STRING} _REQUEST(=|\[|\%[0-9A-Z]{0,2})
    RewriteRule .* index.php [F,L]
</IfModule>

# Headers de sécurité
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header unset X-Powered-By
    Header unset Server
</IfModule>

# -----------------------------------------------
# Performance
# -----------------------------------------------

# Compression Gzip
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Cache navigateur pour les assets statiques
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg         "access plus 1 year"
    ExpiresByType image/jpeg        "access plus 1 year"
    ExpiresByType image/png         "access plus 1 year"
    ExpiresByType image/webp        "access plus 1 year"
    ExpiresByType image/svg+xml     "access plus 1 year"
    ExpiresByType image/gif         "access plus 1 year"
    ExpiresByType text/css          "access plus 3 months"
    ExpiresByType application/javascript "access plus 3 months"
    ExpiresByType application/x-font-ttf "access plus 1 year"
    ExpiresByType font/opentype     "access plus 1 year"
    ExpiresByType font/woff2        "access plus 1 year"
</IfModule>
